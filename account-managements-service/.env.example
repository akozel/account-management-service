# Copy this file to .env for machine-local configuration:
#
#   cp .env.example .env
#
# Do not commit .env: it may contain credentials or other secrets.
#
# PostgreSQL connection string used by the event store.
DATABASE_URL=postgresql://account_management:account_management@localhost:5432/account_management

# HTTP listener address.
BIND_ADDRESS=0.0.0.0:3000

# Runtime log level: off, error, warn, info, debug, or trace.
RUST_LOG=info

# Outbox actors per service instance.
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_POLL_INTERVAL_MS=1000

# Total time for ONE handler invocation: all side-effect attempts, local retry
# backoff, SDK retries, and processing overhead must fit inside these 30 seconds.
# Handler budget = sum(attempt durations) + sum(local backoff) + overhead.
# A 10-second first attempt leaves at most 20 seconds for ALL remaining retries,
# backoff, and overhead together. Three TOTAL attempts at their 10-second maximum
# already use 30 seconds before backoff; three RETRIES mean four total attempts
# and require up to 40 seconds plus backoff. The runtime does not promise those
# four attempts will finish: handler policies must fit the total budget.
# For example: first attempt <= 10s, three retries <= 4s each, and three backoffs
# <= 2s each use 10 + 3*4 + 3*2 = 28s, leaving 2s for overhead. This is only an
# illustrative handler policy; durable outbox retries are separate invocations.
OUTBOX_HANDLER_TIMEOUT_SECS=30

# Fixed DB ownership duration per claim; no automatic lease renewal is enabled.
# Startup requires:
#   lease > claim budget + handler budget + settlement budget + safety margin
#         = 2 * OUTBOX_STORAGE_TIMEOUT_MS / 1000
#           + OUTBOX_HANDLER_TIMEOUT_SECS + 5 seconds (fixed runtime margin).
# Defaults: 60 > 5 + 30 + 5 + 5 = 45 seconds, leaving 15 seconds of extra headroom.
# Each task also keeps its original conservative monotonic deadline from BEFORE
# the claim request. Collection, connection waits, commit, dispatch, and mailbox
# delay consume that budget. A full handler budget plus settlement reserve must
# still fit at execution time, otherwise the task is retried without running its
# effect (or left for lease recovery if safe settlement is no longer possible).
# Settlement waiting is capped by both the storage timeout and lease minus the
# 5-second margin. Database lock-token and expiry checks remain authoritative.
OUTBOX_LEASE_SECS=60

# Runtime deadline in milliseconds for one complete claim batch (all supported
# formats together), one expired-lease recovery, or one settlement operation.
# Includes waiting for a pool connection, SQL, transaction commit, and responses.
# On timeout the runtime releases its await/worker capacity; the database result
# can be unknown, so unfinished tasks follow lease recovery and safe redelivery.
# This does not limit handler execution (OUTBOX_HANDLER_TIMEOUT_SECS) or cancel
# an already-performed side effect. Must be positive; default: 5000 ms.
OUTBOX_STORAGE_TIMEOUT_MS=5000

# PostgreSQL server timeout in milliseconds for EACH SQL statement in an outbox
# claim, recovery, or settlement transaction, including waiting for row/table
# locks. Applied with transaction-local set_config (equivalent to SET LOCAL);
# existing connection settings are restored after commit/rollback. Event-store
# commands and other users of the shared pool are not changed by this setting.
# PostgreSQL aborts an over-budget statement; this is not an end-to-end network
# or transaction deadline, and timeout does not prove a known commit outcome.
# Must be 1..2147483647 ms; zero (which disables PostgreSQL timeout) is rejected.
# Prefer a value below OUTBOX_STORAGE_TIMEOUT_MS to leave time for responses,
# but the clocks start at different points and a recovery can run multiple SQL
# statements. Default: 4000 ms. No separate lock_timeout is required because
# statement_timeout also bounds SQL's lock waiting.
OUTBOX_POSTGRES_STATEMENT_TIMEOUT_MS=4000
