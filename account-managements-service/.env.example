# Copy this file to .env for machine-local configuration:
#
#   cp .env.example .env
#
# Do not commit .env: it may contain credentials or other secrets.
# Missing .env is allowed; unreadable or malformed files stop startup safely.
# All service settings are validated before logger setup and DB connection.
#
# Required PostgreSQL URI (postgres:// or postgresql://).
# The connection helper preserves a pool limit of 10 and other SQLx defaults.
DATABASE_URL=postgresql://account_management:account_management@localhost:5432/account_management

# Required numeric IPv4/IPv6 address and port; hostname:port is not supported.
# IPv6 example: [::]:3000.
BIND_ADDRESS=0.0.0.0:3000

# Runtime log level: off, error, warn, info, debug, or trace.
# Case-insensitive names and numeric aliases 0..5 retain LevelFilter behavior.
# Missing RUST_LOG defaults to info; an empty value means error.
# EnvFilter directives such as module=debug are not supported.
RUST_LOG=info

# OutboxRuntimeConfig loads the coordinator and worker settings below and
# validates their combined lease budget BEFORE connecting to PostgreSQL.
# All worker registries are then prepared BEFORE opening the HTTP listener.
# Preparation performs no claims or delivery; processing starts only in run.
# Permanent registry-owning Tokio tasks / concurrent deliveries per process.
# Independent of CPU count; execution slots include settlement.
OUTBOX_WORKER_CONCURRENCY=128
# Claimed deliveries waiting locally; positive bounded-channel element capacity.
# Increase independently of concurrency, subject to the combined lease budget.
OUTBOX_QUEUE_CAPACITY=128
OUTBOX_POLL_INTERVAL_MS=1000

# Total budget for one handler invocation, including every local retry,
# backoff, SDK retry and processing overhead. For example, three attempts capped
# at 4s plus two 1s backoffs use 14s, leaving 1s of this budget for overhead.
# Durable redelivery is a separate invocation and requires receiver idempotency.
OUTBOX_HANDLER_TIMEOUT_SECS=15

# Fixed DB ownership duration per claim; no automatic lease renewal is enabled.
# C=concurrency, Q=queue capacity, H=handler timeout, S=storage timeout in seconds.
# Startup requires lease > 2*S + H + 5s + ceil(Q/C)*(H+S).
# Defaults: 60 > 12 + 15 + 5 + 21 = 53 seconds; 7 seconds extra headroom.
# C=2, Q=3 needs lease >74 seconds with default H/S; raise lease above 74.
# Waiting in the local queue consumes the original conservative monotonic lease
# from BEFORE the claim request. Delayed deliveries are checked before execution;
# insufficient budget triggers retry without running the handler, or recovery.
# Database lock-token and expiry checks remain authoritative.
OUTBOX_LEASE_SECS=60

# Runtime deadline in milliseconds for one complete claim batch (all supported
# formats together), one expired-lease recovery, or one settlement operation.
# Includes waiting for a pool connection, SQL, transaction commit, and responses.
# On timeout the runtime releases its await/worker capacity; the database result
# can be unknown, so unfinished tasks follow lease recovery and safe redelivery.
# This does not limit handler execution (OUTBOX_HANDLER_TIMEOUT_SECS) or cancel
# an already-performed side effect. Must be positive; default: 6000 ms.
OUTBOX_STORAGE_TIMEOUT_MS=6000

# PostgreSQL server timeout in milliseconds for EACH SQL statement in an outbox
# claim, recovery, or settlement transaction, including waiting for row/table
# locks. Applied with transaction-local set_config (equivalent to SET LOCAL);
# existing connection settings are restored after commit/rollback. Event-store
# commands and other users of the shared pool are not changed by this setting.
# PostgreSQL aborts an over-budget statement; this is not an end-to-end network
# or transaction deadline, and timeout does not prove a known commit outcome.
# Must be 1..2147483647 ms; zero (which disables PostgreSQL timeout) is rejected.
# Prefer a value below OUTBOX_STORAGE_TIMEOUT_MS to leave time for responses,
# but the clocks start at different points and a recovery can run multiple SQL
# statements. Default: 4000 ms. No separate lock_timeout is required because
# statement_timeout also bounds SQL's lock waiting.
OUTBOX_POSTGRES_STATEMENT_TIMEOUT_MS=4000
