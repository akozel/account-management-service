    {
      "id": "C3GIaXZFcQysLR9oWwHmF",
      "type": "text",
      "x": 3240,
      "y": -39220,
      "width": 407.9208984375,
      "height": 300,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 1869715102,
      "version": 693,
      "versionNonce": 1010262274,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789659305822,
      "created": 1789657591865,
      "link": null,
      "locked": false,
      "text": "event is a fact indicating that the aggregate state\nhas changed as a result of a successfully\nvalidated domain command.\n\nIf a domain command contains a relative operation,\nsuch as incrementing a value, it can be useful\nto express the resulting event in absolute terms.\n\nFor example, instead of emitting CounterIncremented(5),\nthe aggregate may emit CounterChangedTo(15).\n\nUsing absolute values may make \na particular state transition naturally idempotent,\nbut duplicate event delivery should still\nbe handled using event IDs / sequence numbers.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "event is a fact indicating that the aggregate state\nhas changed as a result of a successfully\nvalidated domain command.\n\nIf a domain command contains a relative operation,\nsuch as incrementing a value, it can be useful\nto express the resulting event in absolute terms.\n\nFor example, instead of emitting CounterIncremented(5),\nthe aggregate may emit CounterChangedTo(15).\n\nUsing absolute values may make \na particular state transition naturally idempotent,\nbut duplicate event delivery should still\nbe handled using event IDs / sequence numbers.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
