      "version": 1085,
      "versionNonce": 1855434498,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789659437382,
      "created": 1789658426297,
      "link": null,
      "locked": false,
      "text": "query data is usually denormalized and\noptimized for reading.\n\nSince the event stream represents historical domain facts,\nit can be replayed to rebuild existing projections or create\nnew ones when requirements change,\nwithout modifying the write model.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "query data is usually denormalized and\noptimized for reading.\n\nSince the event stream represents historical domain facts,\nit can be replayed to rebuild existing projections or create\nnew ones when requirements change,\nwithout modifying the write model.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "XXE8JL-nwAzt_HTHI-H-r",
      "type": "text",
      "x": 2040,
      "y": -38820,
      "width": 353.50469970703125,
      "height": 120,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 1782680478,
      "version": 226,
      "versionNonce": 1495384130,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789659909187,
      "created": 1789659630490,
      "link": null,
      "locked": false,
      "text": "[Aggregate] is a consistency boundary that owns\ndomain state and enforces business invariants.\n\nIt processes commands, validates them against\nthe current state, and produces domain events\ndescribing accepted state changes.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[Aggregate] is a consistency boundary that owns\ndomain state and enforces business invariants.\n\nIt processes commands, validates them against\nthe current state, and produces domain events\ndescribing accepted state changes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
