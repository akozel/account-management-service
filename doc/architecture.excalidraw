    {
      "id": "z50xWtDJO8XBdSfRAOdfY",
      "type": "text",
      "x": 3240.163623828823,
      "y": -39499.994158897185,
      "width": 377.52081298828125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 988463326,
      "version": 458,
      "versionNonce": 401268894,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789658211847,
      "created": 1789427311826,
      "link": null,
      "locked": false,
      "text": "task is a single [side effect] operation,\n\nif multiple sequential steps are needed \nit should be resolved with flow:\naggregate state -> business rules -> new event/task\n\nTask may have following statuses: \n1) Pending (with delay option), 2) Processing,\n3) Completed, 4) Failed",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "task is a single [side effect] operation,\n\nif multiple sequential steps are needed \nit should be resolved with flow:\naggregate state -> business rules -> new event/task\n\nTask may have following statuses: \n1) Pending (with delay option), 2) Processing,\n3) Completed, 4) Failed",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "zwDhsHvMj70Zh6gC67wH0",
      "type": "line",
