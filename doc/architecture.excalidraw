    {
      "id": "4yf-khFaB40i5pBorHgTc",
      "type": "text",
      "x": 3240,
      "y": -38800,
      "width": 415.8249206542969,
      "height": 140,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
